COMPOSE_PROJECT_NAME=__PROJECT_NAME__
PROJECT_NAME=__PROJECT_NAME__

# 容器之間以「服務名稱」互連（Docker Compose 內建 DNS），不指定固定 IP/網段，
# 由 Docker 自動分配網段，避免多專案並存時 subnet 衝突。

# PG（服務名 pg）
POSTGRES_HOST=pg
# 自動建立 DB
POSTGRES_DB=__PROJECT_NAME__
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432
# PG shm size（shared memory buffer），可依實際用量於 docker logs 觀察後調整
POSTGRES_SHM_SIZE=512

# Redis（服務名 redis）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# FE
FRONTEND_PORT=3000

# BFF Path (for client)
API_URL="/api"

# Backend Service Paths（容器內以服務名 springboot 連線）
AUTH_API_BASE="http://springboot:8080/api"
RESOURCE_API_BASE="http://springboot:8080/api"

# Nuxt runtimeConfig overrides (需要 NUXT_ 前綴)
NUXT_AUTH_API=http://springboot:8080/api
NUXT_RESOURCE_API=http://springboot:8080/api

# BE
# JWT 金鑰須為 Base64（程式以 Base64 decode）。產生：openssl rand -base64 32
# 下面是 dev 預設值，方便開箱即用；正式環境請重新產生並改掉。
JWT_SECRET=wVC9HpvrqKceHwCTr/Vky8HAR44sCbdbdthKeVffTkw=
BACKEND_PORT=8080
DEBUG_PORT=5005
AUTH_SECRET=dev-auth-secret-change-me
