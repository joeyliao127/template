package __PACKAGE__.controller.__entity__;

import java.net.URI;
import java.util.UUID;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import __PACKAGE__.common.command.PageCommand;
import __PACKAGE__.common.dto.ApiResponse;
import __PACKAGE__.common.dto.PageResponse;
import __PACKAGE__.domain.__entity__.__ENTITY__Condition;
import __PACKAGE__.domain.__entity__.__ENTITY__CreateCommand;
import __PACKAGE__.domain.__entity__.__ENTITY__DTO;
import __PACKAGE__.domain.__entity__.__ENTITY__UpdateCommand;
import __PACKAGE__.service.__ENTITY__Service;

import jakarta.validation.Valid;

@RestController
@RequestMapping("/__resource__")
public class __ENTITY__Controller {

    private final __ENTITY__Service __entity__Service;

    public __ENTITY__Controller(__ENTITY__Service __entity__Service) {
        this.__entity__Service = __entity__Service;
    }

    // GET /api/__resource__?page=1&pageSize=20&name=...
    @GetMapping
    public ResponseEntity<PageResponse<__ENTITY__DTO>> index(__ENTITY__Condition condition, PageCommand page) {
        return ResponseEntity.ok(__entity__Service.index(condition, page));
    }

    @GetMapping("/{id}")
    public ResponseEntity<__ENTITY__DTO> getById(@PathVariable UUID id) {
        return ResponseEntity.ok(__entity__Service.getById(id));
    }

    @PostMapping
    public ResponseEntity<__ENTITY__DTO> create(@RequestBody @Valid __ENTITY__CreateCommand command) {
        __ENTITY__DTO dto = __entity__Service.create(command);
        return ResponseEntity.status(HttpStatus.CREATED)
                .location(URI.create("/api/__resource__/" + dto.getId()))
                .body(dto);
    }

    @PutMapping("/{id}")
    public ResponseEntity<__ENTITY__DTO> update(@PathVariable UUID id, @RequestBody @Valid __ENTITY__UpdateCommand command) {
        return ResponseEntity.ok(__entity__Service.update(id, command));
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<ApiResponse> delete(@PathVariable UUID id) {
        __entity__Service.delete(id);
        return ResponseEntity.ok(new ApiResponse(true, "__ENTITY__ deleted"));
    }
}
